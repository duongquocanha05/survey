GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
GAS_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
GAS_SHARED_SECRET=PASTE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
SESSION_SECRET=PASTE_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
PUBLIC_ORIGIN=http://localhost:3000

# Optional AI: only enable on a verified Google AI Studio Free Tier project.
# Do not link billing. Paste the real key only in Render Environment, never GitHub.
GEMINI_API_KEY=
GEMINI_FREE_TIER_CONFIRMED=false
# Conservative local quota, does not replace the provider's quota or verify billing.
LOCKER_AI_MAX_DAILY=20
# OPENAI_API_KEY is not used by Locker chat in free-only mode.
